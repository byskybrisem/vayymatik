  "lines": [
    {
      "id": "hook",
      "text": "Bir enerji içeceği şirketi, neden bir insanı {uzayın sınırından} {Dünya'ya} atlatır?",
      "pause_after": 0.42
    },
    {
      "id": "origin",
      "text": "Hikâye {Tayland'da} başlıyor."
    },
    {
      "id": "tonic",
      "text": "{w:Kamyon şoförleri} ve {w:işçiler} için bir tonik: {Krating Daeng|Krating Deng}."
    },
    {
      "id": "discover",
      "text": "{g:1982'de} {Dietrich Mateschitz|Ditrih Mateşits} onu keşfetti."
    },
    {
      "id": "launch",
      "text": "Tarifi {Batı'ya} uyarladı, {g:1987'de} {Avusturya'da} satışa sundu.",
      "pause_after": 0.3
    },
    {
      "id": "pivot",
      "text": "Ama {klasik reklamın} ötesine geçti.",
      "pause_after": 0.15
    },
    {
      "id": "sports",
      "text": "{Ekstrem sporlar}, kendi etkinlikleri, kendi yıldızları.",
      "pause_after": 0.2
    },
    {
      "id": "f1",
      "text": "{g:2005'te} kendi {Formula 1|Formula bir} takımını kurdu, {şampiyonluklar} kazandı.",
      "pause_after": 0.2
    },
    {
      "id": "football",
      "text": "Futbolda {Salzburg'dan} {Leipzig'e|Laypzig'e} kulüplerin sahibi oldu.",
      "pause_after": 0.2
    },
    {
      "id": "media",
      "text": "Hatta kendi {medya şirketini} kurdu.",
      "pause_after": 0.45
    },
    {
      "id": "stratos",
      "text": "Ve {g:2012'de} bir adamı, {g:39 kilometreden} atlattı."
    },
    {
      "id": "live",
      "text": "Zirvede, {YouTube'da|Yutubda} {g:8 milyondan fazla} eş zamanlı canlı yayın izlendi.",
      "pause_after": 0.35
    },
    {
      "id": "numbers",
      "text": "Sonuç? {g:2025'te} {g:12,2 milyar avro} ciro, yaklaşık {g:14 milyar kutu}.",
      "pause_after": 0.45
    },
    {
      "id": "final1",
      "text": "{Red Bull|Red Bul} sadece bir içecek satmadı."
    },
    {
      "id": "final2",
      "text": "İnsanların {izlemek istediği} bir {dünya} kurdu.",
      "captions": false
    }
  ],
