 "lines": [
  {
   "id": "s4_hook",
   "text": "Okyanusun dibindeki uygarlık bize {bir mesaj} gönderseydi ne olurdu?",
   "pause_after": 0.15
  },
  {
   "id": "gonder",
   "text": "Robotun hoparlörlerinden aşağıya basit bir mesaj gönderiliyor: {g:Bir}, {g:iki}, {g:üç}, {g:beş}, {g:yedi}. {Biz de saymayı biliyoruz}.",
   "pause_after": 0.15
  },
  {
   "id": "yanit",
   "text": "Sonra şehir {yanıt veriyor}. Dizinin devamını gönderiyor: {g:on bir}, {g:on üç}, {g:on yedi}… ve ardından, çok daha karmaşık bir desen.",
   "pause_after": 0.15
  },
  {
   "id": "siluet",
   "text": "Işıkların hemen ötesinde, {devasa bir silüet}. Durgun. Sessiz. İzliyor.",
   "pause_after": 0.15
  },
  {
   "id": "ritim",
   "text": "Gövdesindeki ışıklar, {sinyalle aynı ritimde} yanıp sönüyor."
  },
  {
   "id": "kopus",
   "text": "Ve sonra… {bağlantı kopuyor}.",
   "pause_after": 0.35
  },
  {
   "id": "s_cta",
   "text": "Hikâyenin tamamı, kanaldaki uzun videoda."
  }
 ],
