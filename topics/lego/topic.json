 "lines": [
  {
   "id": "hook",
   "text": "{LEGO'nun|Legonun} bir zamanlar {batmak üzere} olduğunu biliyor muydun?",
   "pause_after": 0.3
  },
  {
   "id": "sat",
   "text": "{g:2003} yılında şirketin satışları {g:yüzde 26} düştü.",
   "pause_after": 0.2
  },
  {
   "id": "zarar",
   "text": "Vergi öncesi zararı tam {g:1,43 milyar} Danimarka kronuna ulaştı!",
   "pause_after": 0.3
  },
  {
   "id": "odak",
   "text": "Şirket, {ana işinden} uzaklaşmış ve maliyetlerini kontrol etmekte zorlanmıştı.",
   "pause_after": 0.3
  },
  {
   "id": "yon",
   "text": "{g:2004} yılında {yönetim} değişti.",
   "pause_after": 0.2
  },
  {
   "id": "azalt",
   "text": "Gereksiz faaliyetler azaltıldı.",
   "pause_after": 0.1
  },
  {
   "id": "park",
   "text": "Hatta {g:2005} yılında {LEGOLAND|Legoland} eğlence parkları bile {satıldı}!",
   "pause_after": 0.3
  },
  {
   "id": "don",
   "text": "{LEGO|Lego} yeniden en iyi bildiği işe odaklandı: {oyuncak tuğlalarına}.",
   "pause_after": 0.3
  },
  {
   "id": "sonuc",
   "text": "Ve {sonuç}?",
   "pause_after": 0.25
  },
  {
   "id": "rakam",
   "text": "{g:2025} yılında {g:83,5 milyar} kron ciro ve {g:16,7 milyar} kron net kâr!",
   "pause_after": 0.35
  },
  {
   "id": "final",
   "text": "{LEGO'yu|Legoyu} kurtaran şey, daha fazla iş yapmak değil, {doğru işe} odaklanmaktı."
  }
