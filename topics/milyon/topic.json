 "lines": [
  {
   "id": "hook",
   "text": "Bir sabah uyandın, telefonuna baktın ve hesabında tam {g:bir milyon lira} var!",
   "pause_after": 0.3
  },
  {
   "id": "herkes",
   "text": "Ama sadece senin değil, {herkesin} hesabına aynı para yatmış.",
   "pause_after": 0.3
  },
  {
   "id": "zengin",
   "text": "İlk başta herkes {zengin} olduğunu düşünürdü.",
   "pause_after": 0.2
  },
  {
   "id": "magaza",
   "text": "İnsanlar {araba}, {ev} ve {telefon} almak için {mağazalara} koşardı.",
   "pause_after": 0.2
  },
  {
   "id": "sorun",
   "text": "Ama ortada büyük bir {sorun} var.",
   "pause_after": 0.2
  },
  {
   "id": "ayni",
   "text": "Para miktarı arttı, fakat satılık evlerin, arabaların ve ürünlerin sayısı {aynı kaldı}!",
   "pause_after": 0.2
  },
  {
   "id": "talep",
   "text": "{Talep} hızla yükselirken {fiyatlar} da artmaya başlayabilirdi.",
   "pause_after": 0.2
  },
  {
   "id": "calisan",
   "text": "Bazı insanlar {çalışmayı bırakabilir}, işletmeler çalışan bulmakta {zorlanabilirdi}.",
   "pause_after": 0.2
  },
  {
   "id": "guc",
   "text": "Bir milyon liranın {satın alma gücü} giderek düşebilirdi.",
   "pause_after": 0.2
  },
  {
   "id": "servet",
   "text": "Çünkü {para üretmek}, gerçek {servet} üretmekle aynı şey değildir.",
   "pause_after": 0.2
  },
  {
   "id": "final",
   "text": "Herkes {milyoner} olsa bile, herkes {zengin} olamazdı.",
   "pause_after": 0.25
  },
  {
   "id": "soru",
   "text": "Peki sen hesabına bir milyon lira yatsa, {ilk ne alırdın}?"
  }
 ],
