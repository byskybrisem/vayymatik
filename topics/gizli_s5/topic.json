 "lines": [
  {
   "id": "s5_hook",
   "text": "Bu keşif bütün {dünya ekonomisini} değiştirebilirdi!",
   "pause_after": 0.15
  },
  {
   "id": "sizinti",
   "text": "Görüntüler resmî bir açıklamadan önce sızıyor. Birkaç saat içinde {milyarlarca ekrana} ulaşıyor.",
   "pause_after": 0.15
  },
  {
   "id": "piyasa",
   "text": "Piyasalar sarsılıyor. Enerji, savunma ve deniz taşımacılığı hisselerinde {sert dalgalanmalar} yaşanıyor.",
   "pause_after": 0.15
  },
  {
   "id": "ekonomi",
   "text": "Tek bir enerji teknolojisi bile, petrolden elektriğe bütün piyasaları altüst edebilirdi. Tek bir patent, koca bir sektörü {bitirebilirdi}.",
   "pause_after": 0.15
  },
  {
   "id": "hukuk",
   "text": "Uluslararası deniz hukukuna göre, ülkelerin yetki alanı dışındaki okyanus tabanı, {insanlığın ortak mirası} sayılıyor."
  },
  {
   "id": "miras",
   "text": "Peki ya orada, bizden çok önce yaşayan biri varsa? O miras, gerçekte {kime ait}?",
   "pause_after": 0.35
  },
  {
   "id": "s_cta",
   "text": "Hikâyenin tamamı, kanaldaki uzun videoda."
  }
