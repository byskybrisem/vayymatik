 "lines": [
  {
   "id": "s6_hook",
   "text": "Onları ilk kez keşfettiğimizi düşündük. Ama onlar {bizi zaten tanıyordu}.",
   "pause_after": 0.15
  },
  {
   "id": "cozum",
   "text": "Aylar süren çalışmanın ardından, sinyallerin bir bölümü {çözülüyor}."
  },
  {
   "id": "harita",
   "text": "İlk anlaşılan şey, bir {harita}. Ekranda, Dünya'nın okyanuslarında yanıp sönen noktalar beliriyor."
  },
  {
   "id": "pasifik",
   "text": "{w:Pasifik}."
  },
  {
   "id": "atlantik",
   "text": "{w:Atlantik}."
  },
  {
   "id": "hint",
   "text": "{w:Hint Okyanusu}."
  },
  {
   "id": "tek",
   "text": "Keşfedilen şehir, {tek değil}."
  },
  {
   "id": "kayit",
   "text": "Okyanusu dinleyen istasyonların eski kayıtları yeniden inceleniyor. Bu noktalardan gelen sinyaller, {yıllardır} oradaymış. Biz onları doğanın sesi sanmışız.",
   "pause_after": 0.15
  },
  {
   "id": "mesaj",
   "text": "{Biz sizi uzun zamandır izliyoruz.}",
   "pause_after": 0.15
  },
  {
   "id": "cta",
   "text": "Sen olsaydın, onlarla {iletişim kurar mıydın}?",
   "pause_after": 0.35
  },
  {
   "id": "s_cta",
   "text": "Hikâyenin tamamı, kanaldaki uzun videoda."
  }
 ],
