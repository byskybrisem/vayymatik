 "lines": [
  {
   "id": "s1_hook",
   "text": "Bilim insanları okyanusun {g:8.000 metre} altında bir sinyal yakalasaydı ne olurdu?",
   "pause_after": 0.3
  },
  {
   "id": "sinyal",
   "text": "Ama bir gece, sensörler yaklaşık {g:8.000 metre} derinlikten gelen {tuhaf bir sinyal} yakalıyor.",
   "pause_after": 0.3
  },
  {
   "id": "asal",
   "text": "Atımlar rastgele değil. {g:İki} atım. Sessizlik. {g:Üç} atım. Sessizlik. Sonra {g:beş}, {g:yedi}, {g:on bir}, {g:on üç}.",
   "pause_after": 0.3
  },
  {
   "id": "doga",
   "text": "Bilinen hiçbir doğal süreç, asal sayıları {sırayla sayamaz}.",
   "pause_after": 0.3
  },
  {
   "id": "rov",
   "text": "Ertesi sabah karar verilir. Sinyalin kaynağına {insansız bir denizaltı} gönderilecek.",
   "pause_after": 0.3
  },
  {
   "id": "m8000",
   "text": "{g:Sekiz bin metre}. Basınç, yaklaşık {g:800 atmosfer}.",
   "pause_after": 0.3
  },
  {
   "id": "carpma",
   "text": "Robot yavaşlıyor. Işıklar dibe yaklaşıyor. Ve sonra… ışık, {bir şeye çarpıyor}.",
   "pause_after": 0.45
  },
  {
   "id": "s_cta",
   "text": "Hikâyenin tamamı, kanaldaki uzun videoda."
  }
 ],
