 },
 "lines": [
  {
   "id": "s2_hook",
   "text": "Bir denizaltı okyanusun dibinde, ışıkları açık {devasa bir şehir} bulsaydı?",
   "pause_after": 0.15
  },
  {
   "id": "kaya",
   "text": "Bu bir kaya değil. Yüzeyi pürüzsüz. Kenarları, kusursuz {düz çizgiler} halinde uzanıyor.",
   "pause_after": 0.15
  },
  {
   "id": "geri",
   "text": "Pilotlar robotu yükseltiyor. Kamera geri çekildikçe, yapının {tek başına olmadığı} anlaşılıyor."
  },
  {
   "id": "sehir",
   "text": "Karşılarında, okyanus tabanına yayılmış, ışıkları yanan {devasa bir şehir} duruyor."
  },
  {
   "id": "olcek",
   "text": "Kubbeler. Kilometrelerce uzanan bağlantı tünelleri. Ve şehrin ortasında yükselen, dev bir {enerji merkezi}.",
   "pause_after": 0.15
  },
  {
   "id": "ulasim",
   "text": "Tünellerin içinde {ışıklı kapsüller} hareket ediyor. Yani bu şehir, terk edilmiş değil.",
   "pause_after": 0.35
  },
  {
   "id": "s_cta",
   "text": "Hikâyenin tamamı, kanaldaki uzun videoda."
  }
 ],
