 },
 "lines": [
  {
   "id": "s3_hook",
   "text": "Ya Dünya'nın en gelişmiş uygarlığı {insanlar değilse}?",
   "pause_after": 0.15
  },
  {
   "id": "baca",
   "text": "Önce enerji. Okyanus tabanında, sıcaklığı {g:350 dereceyi} aşabilen suyu fışkırtan {hidrotermal bacalar} var. İlk kez {g:1977}'de keşfedildiler.",
   "pause_after": 0.15
  },
  {
   "id": "enerji_kurgu",
   "text": "Ama bu ısıyı, bir şehri çalıştıracak ölçekte toplamak? İşte o kısım {tamamen kurgu}.",
   "pause_after": 0.15
  },
  {
   "id": "sofar",
   "text": "Ve iletişim. Okyanusta, sesin {binlerce kilometre} taşınabildiği doğal bir kanal var: {SOFAR|Sofar} kanalı. Bu da gerçek.",
   "pause_after": 0.15
  },
  {
   "id": "fisilti",
   "text": "Bir uygarlık bu kanalı kullansaydı, okyanusun bir ucundan diğerine {fısıldayabilirdi}."
  },
  {
   "id": "ucurum",
   "text": "Bütün bunlar gerçek olsaydı, aramızdaki fark birkaç yüzyıl değil, belki de {binlerce yıl} olurdu.",
   "pause_after": 0.35
  },
  {
   "id": "s_cta",
   "text": "Hikâyenin tamamı, kanaldaki uzun videoda."
  }
 ],
