{
  "id": "atolye",
  "output_name": "Atolye",
  "language": "tr",
  "duration": 23,
  "lines": [
    {
      "id": "s0",
      "text": "Usta tezgâha yaklaşıyor. Turuncu topa dikkat edin.",
      "pause_after": 0.72
    },
    {
      "id": "s1",
      "text": "Elini uzatıyor ve topu masanın kenarından kaldırıyor.",
      "pause_after": 0.72
    },
    {
      "id": "s2",
      "text": "Şimdi parmakları açılacak. Topun düşeceği yere bakın.",
      "pause_after": 0.72
    },
    {
      "id": "s3",
      "text": "Her sekmede biraz daha az yükseliyor.",
      "pause_after": 0.72
    },
    {
      "id": "s4",
      "text": "Top durdu. Ustanın eli yeniden tezgâha dönüyor.",
      "pause_after": 0.72
    }
  ],
