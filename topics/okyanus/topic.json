  "provider": "external",
  "lead_in": 0.15,
  "tail": 2.4,
  "gap": 0.3
 },
 "foreign_words": [],
 "lines": [
  {
   "id": "l1",
   "text": "Bir sabah uyandığını ve dünyadaki bütün {okyanusların} {yok olduğunu} düşün.",
   "pause_after": 0.3
  },
  {
   "id": "l2",
   "text": "Gezegenimizdeki suyun {g:yüzde 96,5'i|yüzde doksan altı virgül beşi} bir anda {kaybolmuş} olurdu!",
   "pause_after": 0.3
  },
  {
   "id": "l3",
   "text": "{Dev yük gemileri} kilometrelerce derinlikteki okyanus tabanında kalırdı.",
   "pause_after": 0.3
  },
  {
   "id": "l4",
   "text": "Bir zamanlar denizlerle çevrili şehirlerin önünde {devasa uçurumlar} ortaya çıkardı.",
   "pause_after": 0.3
  },
  {
   "id": "l5",
   "text": "{Deniz canlılarının} büyük bölümü hayatta kalamazdı.",
   "pause_after": 0.3
  },
  {
   "id": "l6",
   "text": "Ama asıl {felaket} henüz başlamamıştı.",
   "pause_after": 0.3
  },
  {
   "id": "l7",
   "text": "Okyanuslar olmadan {su döngüsü} büyük ölçüde bozulur, {yağışlar} ciddi şekilde azalırdı.",
   "pause_after": 0.3
  },
  {
   "id": "l8",
   "text": "{Tarım} çökmeye başlar, içilebilir su kaynakları giderek azalırdı.",
   "pause_after": 0.3
  },
  {
   "id": "l9",
   "text": "Gezegenin {sıcaklık dengesi} altüst olurdu.",
   "pause_after": 0.3
  },
  {
   "id": "l10",
   "text": "{Milyarlarca} insanın yaşamı tehlikeye girerdi.",
   "pause_after": 0.3
  },
  {
   "id": "l11",
   "text": "Mavi gezegenimiz, zamanla devasa ve {kurak} bir dünyaya dönüşebilirdi.",
   "pause_after": 0.3
  },
  {
   "id": "l12",
   "text": "Meğer {okyanuslar}, gezegenimizin hayatta kalmasını sağlayan en önemli sistemlerden biriymiş.",
   "pause_after": 0.3
  }
 ],
